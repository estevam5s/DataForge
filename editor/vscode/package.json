{
  "name": "dataforge-language",
  "displayName": "DataForge Language",
  "description": "Suporte à linguagem DataForge (.df) — Syntax highlighting, ícone e snippets",
  "version": "3.0.0",
  "publisher": "dataforge-team",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": ["Programming Languages"],
  "icon": "../../public/DataForge.png",
  "contributes": {
    "languages": [
      {
        "id": "dataforge",
        "aliases": ["DataForge", "dataforge", "df"],
        "extensions": [".df"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "../../public/DataForge.png",
          "dark": "../../public/DataForge.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "dataforge",
        "scopeName": "source.dataforge",
        "path": "./syntaxes/dataforge.tmLanguage.json"
      }
    ]
  }
}
