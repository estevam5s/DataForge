{
  "name": "dataforge-language",
  "displayName": "DataForge",
  "description": "Suporte completo à linguagem DataForge (.df): cores, snippets, erros sublinhados, Big-O acima de cada ação, custo de import, botão de rodar com cronômetro, criação de projetos e painel de bancos de dados.",
  "version": "1.0.0",
  "publisher": "dataforge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Debuggers",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "dataforge",
    "df",
    "kiln",
    "crucible",
    "forge",
    "big-o",
    "complexity",
    "linguagem",
    "language",
    "orm"
  ],
  "icon": "icone.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/estevam5s/DataForge"
  },
  "homepage": "https://dataforge-lang.vercel.app/docs/editor",
  "contributes": {
    "languages": [
      {
        "id": "dataforge",
        "aliases": [
          "DataForge",
          "dataforge",
          "df"
        ],
        "extensions": [
          ".df"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icone-arquivo.png",
          "dark": "./icone-arquivo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "dataforge",
        "scopeName": "source.dataforge",
        "path": "./syntaxes/dataforge.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "dataforge",
        "path": "./snippets/dataforge.json"
      }
    ],
    "configurationDefaults": {
      "[dataforge]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "files.trimTrailingWhitespace": true
      }
    },
    "iconThemes": [
      {
        "id": "dataforge",
        "label": "DataForge",
        "path": "./icones-arquivo.json"
      }
    ],
    "commands": [
      {
        "command": "dataforge.rodar",
        "title": "Rodar arquivo",
        "category": "DataForge",
        "icon": "$(play)"
      },
      {
        "command": "dataforge.rodarComTempo",
        "title": "Rodar e medir o tempo",
        "category": "DataForge",
        "icon": "$(watch)"
      },
      {
        "command": "dataforge.rodarDepurando",
        "title": "Rodar com --debug (tokens, AST, traceback)",
        "category": "DataForge",
        "icon": "$(bug)"
      },
      {
        "command": "dataforge.medirRepetido",
        "title": "Medir várias execuções (média, mediana, p95)",
        "category": "DataForge"
      },
      {
        "command": "dataforge.verificar",
        "title": "Verificar erros neste arquivo",
        "category": "DataForge",
        "icon": "$(checklist)"
      },
      {
        "command": "dataforge.formatar",
        "title": "Formatar",
        "category": "DataForge"
      },
      {
        "command": "dataforge.testar",
        "title": "Rodar os testes (Crucible)",
        "category": "DataForge",
        "icon": "$(beaker)"
      },
      {
        "command": "dataforge.complexidade",
        "title": "Analisar complexidade (Big-O)",
        "category": "DataForge",
        "icon": "$(graph)"
      },
      {
        "command": "dataforge.escalaBigO",
        "title": "Big-O: a tabela de referência",
        "category": "DataForge"
      },
      {
        "command": "dataforge.custo",
        "title": "Recalcular o custo dos imports",
        "category": "DataForge"
      },
      {
        "command": "dataforge.novoProjeto",
        "title": "Novo projeto…",
        "category": "DataForge",
        "icon": "$(new-folder)"
      },
      {
        "command": "dataforge.repl",
        "title": "Abrir o REPL",
        "category": "DataForge",
        "icon": "$(terminal)"
      },
      {
        "command": "dataforge.explicarErro",
        "title": "Explicar um código de erro (DF0601)",
        "category": "DataForge"
      },
      {
        "command": "dataforge.documentacao",
        "title": "Abrir a documentação",
        "category": "DataForge",
        "icon": "$(book)"
      },
      {
        "command": "dataforge.conexoes.adicionar",
        "title": "Nova conexão",
        "category": "DataForge",
        "icon": "$(add)"
      },
      {
        "command": "dataforge.conexoes.atualizar",
        "title": "Atualizar",
        "category": "DataForge",
        "icon": "$(refresh)"
      },
      {
        "command": "dataforge.conexoes.remover",
        "title": "Remover",
        "category": "DataForge",
        "icon": "$(trash)"
      },
      {
        "command": "dataforge.conexoes.testar",
        "title": "Testar conexão",
        "category": "DataForge",
        "icon": "$(plug)"
      },
      {
        "command": "dataforge.conexoes.inserir",
        "title": "Inserir o código no editor",
        "category": "DataForge",
        "icon": "$(insert)"
      },
      {
        "command": "dataforge.reiniciarServidor",
        "title": "Reiniciar o servidor de linguagem",
        "category": "DataForge"
      },
      {
        "command": "dataforge.verTokens",
        "title": "Ver os tokens deste arquivo",
        "category": "DataForge",
        "icon": "$(symbol-key)"
      },
      {
        "command": "dataforge.verAst",
        "title": "Ver a árvore sintática",
        "category": "DataForge",
        "icon": "$(list-tree)"
      },
      {
        "command": "dataforge.verEstatisticas",
        "title": "Inventário do projeto",
        "category": "DataForge",
        "icon": "$(graph-scatter)"
      },
      {
        "command": "dataforge.perfilar",
        "title": "Perfilar: tempo por ação",
        "category": "DataForge",
        "icon": "$(dashboard)"
      },
      {
        "command": "dataforge.porQue",
        "title": "Por que isto é assim?",
        "category": "DataForge",
        "icon": "$(lightbulb)"
      },
      {
        "command": "dataforge.lint",
        "title": "Lint deste arquivo",
        "category": "DataForge",
        "icon": "$(checklist)"
      },
      {
        "command": "dataforge.corrigir",
        "title": "Corrigir o que dá para corrigir",
        "category": "DataForge",
        "icon": "$(wand)"
      },
      {
        "command": "dataforge.gerarDoc",
        "title": "Gerar a documentação",
        "category": "DataForge",
        "icon": "$(book)"
      },
      {
        "command": "dataforge.crucible",
        "title": "Rodar o Crucible",
        "category": "DataForge",
        "icon": "$(beaker)"
      },
      {
        "command": "dataforge.depurar",
        "title": "Depurar (usa os breakpoints)",
        "category": "DataForge",
        "icon": "$(debug-alt)"
      },
      {
        "command": "dataforge.avaliar",
        "title": "Avaliar expressão",
        "category": "DataForge",
        "icon": "$(terminal)"
      },
      {
        "command": "dataforge.medirDesempenho",
        "title": "Medir o desempenho (bench)",
        "category": "DataForge",
        "icon": "$(watch)"
      },
      {
        "command": "dataforge.observarArquivo",
        "title": "Observar e reexecutar ao salvar",
        "category": "DataForge",
        "icon": "$(eye)"
      },
      {
        "command": "dataforge.instalarPacotes",
        "title": "Instalar as dependências",
        "category": "DataForge",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dataforge.acrescentarPacote",
        "title": "Acrescentar um pacote…",
        "category": "DataForge",
        "icon": "$(add)"
      },
      {
        "command": "dataforge.procurarPacote",
        "title": "Procurar no registro…",
        "category": "DataForge",
        "icon": "$(search)"
      },
      {
        "command": "dataforge.listarPacotes",
        "title": "Pacotes instalados",
        "category": "DataForge",
        "icon": "$(package)"
      },
      {
        "command": "dataforge.pacotesDesatualizados",
        "title": "Pacotes desatualizados",
        "category": "DataForge",
        "icon": "$(arrow-up)"
      },
      {
        "command": "dataforge.arvoreDeDependencias",
        "title": "Árvore de dependências",
        "category": "DataForge",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dataforge.infoDoProjeto",
        "title": "Ver o forge.toml",
        "category": "DataForge",
        "icon": "$(file-code)"
      },
      {
        "command": "dataforge.limpar",
        "title": "Limpar caches e artefatos",
        "category": "DataForge",
        "icon": "$(trash)"
      },
      {
        "command": "dataforge.listarErros",
        "title": "Todos os códigos de erro",
        "category": "DataForge",
        "icon": "$(error)"
      },
      {
        "command": "dataforge.cobertura",
        "title": "Cobertura: quais linhas os testes rodaram",
        "category": "DataForge"
      },
      {
        "command": "dataforge.coberturaMinima",
        "title": "Cobertura: exigir um mínimo…",
        "category": "DataForge"
      },
      {
        "command": "dataforge.vitrineDev",
        "title": "Vitrine: subir recarregando ao salvar",
        "category": "DataForge"
      },
      {
        "command": "dataforge.vitrineDoctor",
        "title": "Vitrine: por que não sobe?",
        "category": "DataForge"
      },
      {
        "command": "dataforge.devops",
        "title": "DevOps: gerar artefatos…",
        "category": "DataForge"
      },
      {
        "command": "dataforge.devopsDoctor",
        "title": "DevOps: o que falta para subir?",
        "category": "DataForge"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "dataforge.rodar",
          "when": "resourceLangId == dataforge",
          "group": "navigation@1"
        },
        {
          "command": "dataforge.rodarComTempo",
          "when": "resourceLangId == dataforge",
          "group": "navigation@2"
        },
        {
          "command": "dataforge.rodarDepurando",
          "when": "resourceLangId == dataforge",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "dataforge.complexidade",
          "when": "resourceLangId == dataforge",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "dataforge.rodar",
          "when": "resourceLangId == dataforge",
          "group": "dataforge@1"
        },
        {
          "command": "dataforge.rodarComTempo",
          "when": "resourceLangId == dataforge",
          "group": "dataforge@2"
        },
        {
          "command": "dataforge.complexidade",
          "when": "resourceLangId == dataforge",
          "group": "dataforge@3"
        },
        {
          "command": "dataforge.explicarErro",
          "when": "resourceLangId == dataforge",
          "group": "dataforge@4"
        }
      ],
      "explorer/context": [
        {
          "command": "dataforge.rodar",
          "when": "resourceExtname == .df",
          "group": "dataforge@1"
        }
      ],
      "view/title": [
        {
          "command": "dataforge.conexoes.adicionar",
          "when": "view == dataforgeConexoes",
          "group": "navigation@1"
        },
        {
          "command": "dataforge.conexoes.atualizar",
          "when": "view == dataforgeConexoes",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dataforge.conexoes.testar",
          "when": "view == dataforgeConexoes && viewItem == conexao",
          "group": "inline@1"
        },
        {
          "command": "dataforge.conexoes.inserir",
          "when": "view == dataforgeConexoes && viewItem == tabela",
          "group": "inline@1"
        },
        {
          "command": "dataforge.conexoes.remover",
          "when": "view == dataforgeConexoes && viewItem == conexao"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dataforge.rodar",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "resourceLangId == dataforge"
      },
      {
        "command": "dataforge.rodarComTempo",
        "key": "ctrl+shift+f5",
        "mac": "cmd+shift+f5",
        "when": "resourceLangId == dataforge"
      },
      {
        "command": "dataforge.complexidade",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "resourceLangId == dataforge"
      },
      {
        "command": "dataforge.testar",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "resourceLangId == dataforge"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dataforge",
          "title": "DataForge",
          "icon": "marca.svg"
        }
      ]
    },
    "views": {
      "dataforge": [
        {
          "id": "dataforgeFerramentas",
          "name": "Ferramentas",
          "icon": "$(tools)",
          "contextualTitle": "Ferramentas do DataForge"
        },
        {
          "id": "dataforgeConexoes",
          "name": "Bancos de dados",
          "icon": "$(database)",
          "contextualTitle": "Conexões do Forge"
        }
      ]
    },
    "configuration": {
      "title": "DataForge",
      "properties": {
        "dataforge.caminho": {
          "type": "string",
          "default": "",
          "markdownDescription": "Caminho do executável `dataforge`. Vazio procura no PATH e em `~/.dataforge/bin`."
        },
        "dataforge.verificar": {
          "type": "boolean",
          "default": true,
          "description": "Sublinha erros e avisos com o analisador da linguagem — o mesmo que roda no CI."
        },
        "dataforge.complexidade.mostrar": {
          "type": "boolean",
          "default": true,
          "description": "Mostra a complexidade (Big-O) acima de cada ação."
        },
        "dataforge.complexidade.avisarAcimaDe": {
          "type": "string",
          "default": "O(n log n)",
          "enum": [
            "O(1)",
            "O(log n)",
            "O(n)",
            "O(n log n)",
            "O(n^2)",
            "O(n^3)"
          ],
          "markdownDescription": "Marca com `⟵ acima do limite` o que passar desta classe."
        },
        "dataforge.custoDeImport": {
          "type": "boolean",
          "default": true,
          "description": "Mostra quantos símbolos cada 'adopt' traz, ao lado da linha."
        },
        "dataforge.formatarAoSalvar": {
          "type": "boolean",
          "default": false,
          "description": "Roda 'dataforge fmt' ao salvar."
        },
        "dataforge.servidor.ativo": {
          "type": "boolean",
          "default": true,
          "description": "Usa o servidor de linguagem (autocompletar, hover, ir-para-definição, renomear). Desligue para voltar ao diagnóstico simples do 'dataforge check' ao salvar."
        },
        "dataforge.servidor.log": {
          "type": "string",
          "default": "",
          "description": "Caminho de um arquivo onde o servidor grava o que acontece. Vazio = não grava."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "dataforge",
        "owner": "dataforge",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+):\\s*(erro|aviso|error|warning):\\s*(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "dataforge",
        "required": [
          "comando"
        ],
        "properties": {
          "comando": {
            "type": "string",
            "description": "run, check, test, crucible, fmt, big-o"
          },
          "arquivo": {
            "type": "string",
            "description": "o alvo"
          }
        }
      }
    ]
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:dataforge",
    "workspaceContains:**/forge.toml",
    "workspaceContains:**/*.df"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "empacotar": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
