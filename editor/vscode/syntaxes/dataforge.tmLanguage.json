{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DataForge",
  "scopeName": "source.dataforge",
  "fileTypes": [
    "df"
  ],
  "patterns": [
    {
      "include": "#comentarios"
    },
    {
      "include": "#interpolacao"
    },
    {
      "include": "#textos"
    },
    {
      "include": "#numeros"
    },
    {
      "include": "#palavras"
    },
    {
      "include": "#tipos"
    },
    {
      "include": "#decoradores"
    },
    {
      "include": "#rotas"
    },
    {
      "include": "#declaracoes"
    },
    {
      "include": "#globais"
    },
    {
      "include": "#modulos"
    },
    {
      "include": "#chamadas"
    },
    {
      "include": "#operadores"
    },
    {
      "include": "#propriedades"
    }
  ],
  "repository": {
    "comentarios": {
      "patterns": [
        {
          "name": "comment.line.double-slash.dataforge",
          "match": "//(?![\\d(\\s]*[\\d(])[^\\n]*"
        },
        {
          "name": "comment.line.number-sign.dataforge",
          "match": "#[^\\n]*"
        }
      ]
    },
    "interpolacao": {
      "name": "string.interpolated.dataforge",
      "begin": "\\$\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.dataforge",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.expression.dataforge",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.dataforge"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.dataforge"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "textos": {
      "patterns": [
        {
          "name": "string.quoted.triple.dataforge",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.dataforge",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.dataforge",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.dataforge",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.dataforge",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numeros": {
      "patterns": [
        {
          "name": "constant.numeric.hex.dataforge",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.dataforge",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.dataforge",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.dataforge",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "palavras": {
      "patterns": [
        {
          "name": "keyword.control.conditional.dataforge",
          "match": "\\b(otherwise|default|given|match|point|orif|when)\\b"
        },
        {
          "name": "keyword.control.loop.dataforge",
          "match": "\\b(perform|persist|cycle|from|halt|skip|step|to)\\b"
        },
        {
          "name": "keyword.control.flow.dataforge",
          "match": "\\b(propagate|trigger|defer|yield|emit|wait|out)\\b"
        },
        {
          "name": "keyword.control.exception.dataforge",
          "match": "\\b(validate|monitor|recover|assert|ensure|handle|guard|retry)\\b"
        },
        {
          "name": "keyword.control.import.dataforge",
          "match": "\\b(adopt|relay|using|as)\\b"
        },
        {
          "name": "storage.type.dataforge",
          "match": "\\b(blueprint|channel|action|lambda|record|stream|frame|trait|enum)\\b"
        },
        {
          "name": "storage.modifier.dataforge",
          "match": "\\b(protected|abstract|operator|extends|private|shadow|static|steady|final|slots|with|get|set)\\b"
        },
        {
          "name": "keyword.other.oop.dataforge",
          "match": "\\b(delete|spawn|root|self)\\b"
        },
        {
          "name": "keyword.other.async.dataforge",
          "match": "\\b(parallel|observe|thread|async|await|pulse)\\b"
        },
        {
          "name": "keyword.other.data.dataforge",
          "match": "\\b(distill|inspect|predict|typeof|forge|morph|train|cast|sift)\\b"
        },
        {
          "name": "keyword.other.meta.dataforge",
          "match": "\\b(mark)\\b"
        },
        {
          "name": "keyword.other.kiln.dataforge",
          "match": "\\b(middleware|redirect|respond|assets|ignite|render|server|after|mount|route|views)\\b"
        },
        {
          "name": "keyword.operator.word.dataforge",
          "match": "\\b(smaller_eq|bigger_eq|smaller|bigger|isnt|and|not|in|is|or)\\b"
        },
        {
          "name": "constant.language.dataforge",
          "match": "\\b(void|yes|no)\\b"
        }
      ]
    },
    "tipos": {
      "name": "support.type.dataforge",
      "match": "\\b(Boolean|Cluster|Integer|Action|Record|Server|Stream|String|Float|Frame|Vault|Void|Any)\\b"
    },
    "decoradores": {
      "name": "entity.name.function.decorator.dataforge",
      "match": "\\bmark\\s+@[A-Za-z_]\\w*"
    },
    "rotas": {
      "match": "\\b(route)\\s+(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|ANY)\\b",
      "captures": {
        "1": {
          "name": "keyword.other.kiln.dataforge"
        },
        "2": {
          "name": "constant.language.http.dataforge"
        }
      }
    },
    "declaracoes": {
      "patterns": [
        {
          "match": "\\b(action|stream\\s+action)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.dataforge"
            },
            "2": {
              "name": "entity.name.function.dataforge"
            }
          }
        },
        {
          "match": "\\b(blueprint|record|enum|trait)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.dataforge"
            },
            "2": {
              "name": "entity.name.type.dataforge"
            }
          }
        },
        {
          "match": "\\b(server)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "keyword.other.kiln.dataforge"
            },
            "2": {
              "name": "entity.name.type.dataforge"
            }
          }
        }
      ]
    },
    "globais": {
      "name": "support.function.builtin.dataforge",
      "match": "\\b(base64_decode|base64_encode|last_index_of|regex_extract|regex_findall|combinations|permutations|regex_search|removeprefix|removesuffix|assert_type|default_val|frequencies|get_methods|hash_sha256|invert_dict|is_callable|merge_dicts|regex_count|regex_match|regex_split|reverse_str|__expect__|accumulate|capitalize|class_name|complement|constantly|expandtabs|find_first|get_fields|get_parent|has_method|instanceof|interleave|is_boolean|is_integer|percentile|regex_test|repeat_val|rpartition|splitlines|startswith|count_str|deep_copy|enumerate|factorial|find_last|from_json|has_field|is_finite|is_number|is_string|isnumeric|pad_start|partition|regex_sub|substring|timestamp|coalesce|contains|endswith|flat_map|hash_md5|identity|includes|index_of|is_empty|is_float|linhagem|reversed|swapcase|template|validate|variance|zip_with|MAX_INT|MIN_INT|NEWLINE|char_at|cluster|compose|default|degrees|env_var|flatten|get_mro|is_dict|is_list|is_void|isalnum|isalpha|isascii|isdigit|islower|isspace|istitle|isupper|memoize|none_of|pad_end|partial|pipe_fn|product|radians|randint|replace|shuffle|to_json|append|center|choice|concat|decode|encode|exists|filter|format|freeze|insert|is_inf|is_nan|lstrip|median|random|reduce|remove|repeat|rotate|rstrip|sample|sorted|unique|values|EMPTY|atan2|chain|chunk|clamp|count|curry|every|first|float|floor|hypot|index|items|lines|ljust|log10|lower|range|rfind|rjust|round|sleep|slice|split|stdev|strip|title|unzip|upper|vault|words|zfill|acos|asin|atan|bool|cast|cbrt|ceil|char|comb|drop|e_um|find|hash|join|keys|last|lerp|log2|mean|mode|omit|once|perm|pick|scan|sign|some|sqrt|take|thaw|time|trim|type|uuid|INF|NAN|TAB|TAU|abs|cos|exp|gcd|int|lcm|len|log|map|max|min|ord|pop|pow|sin|str|sum|tan|tap|zip|PI|id|E)\\b(?=\\s*\\()"
    },
    "modulos": {
      "name": "support.class.module.dataforge",
      "match": "\\b(Arcane|Serialization|Collections|Concurrent|Functional|Analytics|Qualidade|Corrente|Crucible|Database|Observar|Paralelo|Pipeline|Archive|Logging|Network|Observe|Parquet|Process|Quality|Bridge|Cortex|Crypto|Server|Stream|Async|Banco|Color|Excel|Fluxo|Forge|Ponte|Regex|Serde|Data|Http|Iter|Kiln|Lago|Lake|Math|Meta|Test|Text|Time|Xlsx|Cor|Log|Web|Zip|DB|IO|OS)\\b(?=\\s*\\.)"
    },
    "chamadas": {
      "name": "entity.name.function.call.dataforge",
      "match": "\\b([A-Za-z_]\\w*)\\b(?=\\s*\\()"
    },
    "operadores": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.dataforge",
          "match": ":=|\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.pipeline.dataforge",
          "match": ">>"
        },
        {
          "name": "keyword.operator.arrow.dataforge",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.nullish.dataforge",
          "match": "\\?\\?|\\?\\."
        },
        {
          "name": "keyword.operator.spread.dataforge",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.dataforge",
          "match": "~/|\\*\\*|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.dataforge",
          "match": "==|!=|<=|>=|<|>"
        }
      ]
    },
    "propriedades": {
      "name": "variable.other.property.dataforge",
      "match": "(?<=\\.)\\s*([A-Za-z_]\\w*)"
    }
  }
}
