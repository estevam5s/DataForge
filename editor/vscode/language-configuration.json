{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*:\\s*$",
    "decreaseIndentPattern": "^\\s*(otherwise|orif|handle|ensure|recover)\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(action|blueprint|given|cycle|persist|monitor|trait)\\b",
      "end": "^\\s*$"
    }
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*"
}
