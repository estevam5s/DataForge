{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "$\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*.*:\\s*(//.*)?$",
    "decreaseIndentPattern": "^\\s*(otherwise|orif|handle|ensure|recover|default)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*.*:\\s*$",
      "action": {
        "indent": "indent"
      }
    }
  ],
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*(action|stream\\s+action|blueprint|record|enum|trait|given|cycle|persist|monitor|server|route)\\b",
      "end": "^\\s*$"
    }
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}