blueprint Vetor:
    action setup(x, y):
        self.x := x
        self.y := y

    // Sobrecarga do operador +
    action add(other):
        yield spawn Vetor(self.x + other.x, self.y + other.y)

    // Sobrecarga do operador -
    action sub(other):
        yield spawn Vetor(self.x - other.x, self.y - other.y)

    // Sobrecarga do operador *
    action mul(scalar):
        yield spawn Vetor(self.x * scalar, self.y * scalar)

    // Representação como string
    action toString():
        yield "(" + str(self.x) + ", " + str(self.y) + ")"

v1 := spawn Vetor(1, 2)
v2 := spawn Vetor(3, 4)

v3 := v1 + v2           // Operator overloading!
out v3                   // "(4, 6)" — via toString()

v4 := v1 - v2           // "(-2, -2)"
v5 := v1 * 3            // "(3, 6)"
out v4
out v5
