// ════════════════════════════════════════════════════════════
//  Arcane.Dominio — DDD com as distincoes COBRADAS
//
//  Um blueprint chamado 'Pedido' com um comentario "// agregado"
//  nao impede ninguem de mexer nos itens por fora. O valor das
//  distincoes de DDD esta em serem cobradas, e nao nomeadas.
//
//      dataforge run examples/dominio_ddd.df
// ════════════════════════════════════════════════════════════

adopt Arcane.Dominio as D

out "Arcane.Dominio — o modelo que se sustenta"
out ""

// ── 1. Objeto de valor ──────────────────────────────────────
//
// Igualdade por CONTEUDO, imutavel, e com a regra cobrada na
// criacao — o unico ponto em que ela pode impedir o valor errado
// de existir.

steady Dinheiro := D.valor("Dinheiro", ["quantia", "moeda"],
    regra := lambda v => v["quantia"] bigger_eq 0,
    motivo := "dinheiro nao e negativo")

dez := Dinheiro(10, "BRL")
outro := Dinheiro(10, "BRL")

out "1. objeto de valor"
out $"   {dez} e {outro} sao o mesmo valor: {dez is outro}"

// Trocar um campo e criar OUTRO valor. O original nao muda.
vinte := dez.com(quantia := 20)
assert dez.quantia is 10
assert vinte.quantia is 20

// E a regra vale em toda fronteira, inclusive no 'com'.
recusou := no
monitor:
    Dinheiro(-5, "BRL")
handle Error as e:
    recusou := yes
    out $"   recusado na criacao: {e.message}"
assert recusou

out ""

// ── 2. Entidade ─────────────────────────────────────────────
//
// O que separa uma entidade de um valor nao e a mutabilidade —
// e a CONTINUIDADE. A mesma pessoa com outro nome continua sendo ela.

ana := D.entidade("Pessoa", "1", nome := "Ana")
ana_maria := D.entidade("Pessoa", "1", nome := "Ana Maria")
homonima := D.entidade("Pessoa", "2", nome := "Ana")

out "2. entidade"
out $"   mesma id, outro nome  -> igual:  {ana is ana_maria}"
out $"   mesmo nome, outra id  -> igual:  {ana is homonima}"
assert ana is ana_maria
assert ana isnt homonima

out ""

// ── 3. Agregado: a unica porta de escrita ───────────────────

pedido := D.agregado("Pedido", "PED-7", total := 0, itens := 0)

pedido.invariante("o total nunca e negativo",
    lambda p => p.ler("total", 0) bigger_eq 0)
pedido.invariante("um pedido tem no maximo 3 itens",
    lambda p => p.ler("itens", 0) smaller_eq 3)

mark @pedido.comando("acrescentar")
action acrescentar(p, nome, preco):
    p.mudar(total := p.ler("total", 0) + preco,
        itens := p.ler("itens", 0) + 1)
    p.aconteceu("ItemAcrescentado", {"item": nome, "preco": preco})

mark @pedido.comando("descontar")
action descontar(p, quanto):
    p.mudar(total := p.ler("total", 0) - quanto)

out "3. agregado"

// Escrever por fora e recusado: se qualquer um escreve, a
// invariante nao vale nada — nao ha onde cobra-la.
por_fora := no
monitor:
    pedido.mudar(total := 999999)
handle Error as e:
    por_fora := yes
    out $"   escrita por fora: {e.message}"
assert por_fora
assert pedido.ler("total") is 0

pedido.acrescentar("cafe", 32)
pedido.acrescentar("filtro", 18)
out $"   dois itens -> total {pedido.ler('total')}, versao {pedido.versao()}"
assert pedido.ler("total") is 50
assert pedido.versao() is 2

// O comando que viola a invariante e DESFEITO por inteiro: sem
// isso, a proxima leitura ve um estado que nunca deveria existir.
monitor:
    pedido.descontar(999)
handle Error as e:
    out $"   recusado: {e.message}"

assert pedido.ler("total") is 50
assert pedido.versao() is 2
out "   o estado voltou ao que era, e a versao nao avancou"

out ""

// ── 4. Regra de negocio, como objeto ────────────────────────
//
// Um 'given' dentro do servico nao pode ser combinado, nem
// reaproveitado na consulta, nem explicado ao usuario.

steady grande := D.regra("o pedido passa de R$ 100",
    lambda p => p.ler("total", 0) bigger 100)
steady cheio := D.regra("o pedido tem ao menos 3 itens",
    lambda p => p.ler("itens", 0) bigger_eq 3)
steady vale_frete := grande.e(cheio)

out "4. regra"
out $"   {vale_frete.descricao}"
// A parte QUE FALHOU, e nao a frase inteira: a frase nao diz o que
// a pessoa precisa resolver.
out $"   por que nao: {vale_frete.por_que_nao(pedido)}"
assert vale_frete.por_que_nao(pedido) is "o pedido passa de R$ 100"
assert not vale_frete.vale(pedido)

out ""

// ── 5. Repositorio ──────────────────────────────────────────
//
// Ele guarda AGREGADOS INTEIROS. Um repositorio que devolve meio
// agregado devolve um objeto cujas invariantes ninguem garante.

pedidos := D.repositorio("Pedido")

action pedido_de(id, total, itens):
    a := D.agregado("Pedido", id, total := total, itens := itens)
    yield a

pedidos.guardar(pedido_de("PED-1", 40, 1))
pedidos.guardar(pedido_de("PED-2", 250, 4))
pedidos.guardar(pedido_de("PED-3", 900, 5))

out "5. repositorio"
out $"   guardados: {pedidos.quantos()}"

// A MESMA regra da decisao serve de consulta.
com_frete := pedidos.que(vale_frete)
out $"   com frete gratis: {len(com_frete)}"
assert len(com_frete) is 2

// 'por_id' devolve void; 'exigir' levanta. As duas perguntas existem.
assert pedidos.por_id("PED-404") is void
sumiu := no
monitor:
    pedidos.exigir("PED-404")
handle Error:
    sumiu := yes
assert sumiu

out ""

// ── 6. Unidade de trabalho: o evento espera a confirmacao ───
//
// Publicar na hora faz o mundo reagir a um fato que a transacao
// ainda pode desfazer: o e-mail sai, e o pedido nao existe.

publicados := []

action anotar(fato):
    publicados.append(fato.nome)

out "6. unidade de trabalho"
out $"   eventos pendentes no agregado: {len(pedido.eventos())}"
assert len(pedido.eventos()) is 2

u := D.unidade(publicar := anotar)
u.registrar(pedido, pedidos)
out $"   depois de registrar, publicados: {len(publicados)}"
assert len(publicados) is 0

saindo := u.confirmar()
out $"   depois de confirmar:  {publicados}"
assert len(saindo) is 2
assert publicados is ["ItemAcrescentado", "ItemAcrescentado"]
assert pedidos.quantos() is 4

// E a que e desfeita nao deixa fato nenhum para tras.
outro_pedido := D.agregado("Pedido", "PED-9", total := 0)
outro_pedido.comando("marcar", lambda p => p.aconteceu("PedidoCriado"))
outro_pedido.marcar()

descartada := D.unidade(publicar := anotar)
descartada.registrar(outro_pedido)
descartada.desfazer()
assert len(publicados) is 2
assert len(outro_pedido.eventos()) is 0
out "   a unidade desfeita nao publicou nada"

out ""

// ── 7. Contexto delimitado, e a fronteira ───────────────────
//
// O "Cliente" de Vendas tem limite de credito; o de Suporte tem
// plano e chamados. Passar o objeto inteiro de um lado ao outro e
// o que faz dois modelos virarem um so — e o unico nao serve a ninguem.

vendas := D.contexto("Vendas")
suporte := D.contexto("Suporte")

atendidos := []

mark @suporte.ao_acontecer("PedidoPago")
action abrir_acompanhamento(fato):
    atendidos.append(fato.dados["pedido"])

out "7. contexto delimitado"

sem_traducao := no
monitor:
    suporte.receber("Vendas", "Cliente", {"nome": "Ana", "credito": 5000})
handle Error as e:
    sem_traducao := yes
    out $"   sem traducao: {e.message}"
assert sem_traducao

suporte.traduzir_de("Vendas", "Cliente",
    lambda c => {"nome": c["nome"], "plano": "basico", "chamados": 0})

aqui := suporte.receber("Vendas", "Cliente", {"nome": "Ana", "credito": 5000})
out $"   traduzido: {aqui}"
assert aqui["plano"] is "basico"
assert "credito" not in aqui

suporte.publicar(D.evento("PedidoPago", {"pedido": "PED-7"}))
assert atendidos is ["PED-7"]
out $"   o suporte reagiu ao fato: {atendidos}"

// O ouvinte que estoura nao impede os outros: eles reagem a um fato
// que JA aconteceu, e derrubar os demais deixaria o mundo
// parcialmente atualizado sem ninguem saber.
mark @vendas.ao_acontecer("PedidoPago")
action explodir(_fato):
    trigger "este ouvinte esta quebrado"

vistos := []

mark @vendas.ao_acontecer("PedidoPago")
action tambem_anotar(fato):
    vistos.append(fato.dados["pedido"])

falhas := vendas.publicar(D.evento("PedidoPago", {"pedido": "PED-7"}))
out $"   um ouvinte falhou ({len(falhas)}), o outro rodou: {vistos}"
assert len(falhas) is 1
assert vistos is ["PED-7"]

out ""
out "dominio ok"
