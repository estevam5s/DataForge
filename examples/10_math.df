// ═══════════════════════════════════════════════════════════
//  DataForge - Math & Standard Library Demo
//  Using the Arcane.Math standard library
// ═══════════════════════════════════════════════════════════

out "=== Math Constants ==="
out "PI: " + PI
out "E: " + E
out "TAU: " + TAU

out "\n=== Basic Math ==="
out "sqrt(144) = " + sqrt(144)
out "pow(2, 10) = " + pow(2, 10)
out "abs(-42) = " + abs(-42)
out "round(3.7) = " + round(3.7)
out "floor(3.7) = " + floor(3.7)
out "ceil(3.2) = " + ceil(3.2)

out "\n=== Trigonometry ==="
out "sin(0) = " + sin(0)
out "cos(0) = " + cos(0)

out "\n=== Random Numbers ==="
out "Random: " + random()
out "Randint(1,100): " + randint(1, 100)

colors := ["red", "green", "blue", "yellow"]
out "Random choice: " + choice(colors)

out "\n=== Prime Numbers ==="
action is_prime(n):
    given n smaller 2:
        yield no
    cycle i from 2 to n - 1:
        given n % i is 0:
            yield no
    yield yes

primes := []
cycle i from 2 to 50:
    given is_prime(i):
        append(primes, i)

out "Primes up to 50: " + primes

out "\n=== Fibonacci Sequence ==="
action fib_sequence(count):
    result := [0, 1]
    cycle i from 2 to count - 1:
        next := result[i - 1] + result[i - 2]
        append(result, next)
    yield result

out "First 15 Fibonacci: " + fib_sequence(15)
