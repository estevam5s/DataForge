adopt Arcane.IO

// Escrever arquivo
IO.write_file("dados.txt", "Conteúdo do arquivo")

// Ler arquivo
conteudo := IO.read_file("dados.txt")
out conteudo

// JSON
obj := {"nome": "Ana", "idade": 25}
IO.write_json("user.json", obj)
dados := IO.read_json("user.json")
out dados

// Verificar existência
out IO.file_exists("dados.txt")   // yes

// Listar diretório
out IO.list_dir(".")
