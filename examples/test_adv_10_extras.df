// Freeze / Thaw
dados := [1, 2, 3]
freeze(dados)        // Congela — imutável
// append(dados, 4)  // ❌ Erro!
thaw(dados)          // Descongela
append(dados, 4)    // ✅ OK!
out dados

// Delete e Inspect
x := 42
inspect x            // Mostra tipo, valor e localização

// Hashing e Encoding
out hash_md5("DataForge")
out hash_sha256("DataForge")
out base64_encode("Hello")     // "SGVsbG8="
out base64_decode("SGVsbG8=")  // "Hello"
out uuid()                      // UUID aleatório
out to_json({"a": 1})          // '{"a": 1}'
out from_json('{"a": 1}')     // {"a": 1}
