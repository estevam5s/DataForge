adopt Arcane.Async

// Promise
action buscar_dados():
    sleep(100)
    yield "dados prontos!"

p := Async.promise(buscar_dados)
out Async.resolve(p)

// Event Emitter
emitter := Async.event_emitter()
Async.on(emitter, "msg", action(data):
    out "Recebido: " + data)
Async.emit_event(emitter, "msg", "Olá!")

// Channels
ch := Async.channel()
Async.send(ch, "mensagem")
out Async.receive(ch)   // "mensagem"
