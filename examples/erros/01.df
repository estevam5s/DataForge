// ─── try / catch / finally ───
monitor:
    resultado := 10 / 0
handle err:
    out "Erro capturado: " + str(err)
ensure:
    out "Sempre executa!"

// ─── Lançar erro ───
trigger "Algo deu errado!"

// ─── Guard (precondição) ───
action dividir(a, b):
    guard b != 0 otherwise:
        out "Divisor não pode ser zero!"
    yield a / b

// ─── Validate ───
action set_idade(idade):
    validate idade bigger 0 otherwise:
        trigger "Idade deve ser positiva"
    yield idade

// ─── Retry / Recover ───
retry 3:
    out "Tentando conexão..."
    trigger "Falha de rede"
recover err:
    out "Falhou após 3 tentativas: " + str(err)

// ─── Defer (cleanup) ───
action processar():
    defer:
        out "🧹 Limpeza final..."
    out "⚙️ Processando..."
    // defer executa ao sair da função

// ─── Assert ───
assert 2 + 2 == 4, "Matemática quebrou!"