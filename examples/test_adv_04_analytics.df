adopt Analytics

// ─── Estatísticas Descritivas ───
notas := [85, 92, 78, 95, 67, 88, 73, 91]

out Analytics.mean(notas)         // Média
out Analytics.median(notas)       // Mediana
out Analytics.stdev(notas)        // Desvio padrão
out Analytics.variance(notas)     // Variância
out Analytics.mode(notas)         // Moda
out Analytics.quartiles(notas)    // [Q1, Q2, Q3]
out Analytics.describe(notas)     // Resumo completo

// ─── Regressão Linear ───
x := [1, 2, 3, 4, 5]
y := [2.1, 4.0, 5.9, 8.1, 10.0]

modelo := Analytics.linear_regression(x, y)
out modelo   // {slope: ~2.0, intercept: ~0.1}
out Analytics.predict_linear(modelo, 6)
out Analytics.r_squared(x, y)

// ─── DataFrame ───
dados := [
    ["Ana", 85, "TI"],
    ["Carlos", 92, "TI"],
    ["Maria", 78, "RH"],
    ["Pedro", 91, "TI"]
]
df := Analytics.create_frame(dados, ["nome", "nota", "depto"])

out df.head(2)                    // Primeiras 2 linhas
out df.shape()                    // {rows: 4, cols: 3}
out df.describe()                 // Estatísticas das colunas
out df.sort_by("nota")           // Ordenar por nota

// ─── Clustering K-Means ───
pontos := [[1,1], [1.5,2], [3,4], [5,7], [3.5,5], [4.5,5]]
clusters := Analytics.kmeans(pontos, 2)
out clusters

// ─── Visualização em Texto ───
Analytics.bar_chart([10, 25, 15, 30], ["Q1", "Q2", "Q3", "Q4"])
out Analytics.sparkline([1,3,7,2,5,8,4,6])   // ▁▃▇▂▅█▃▅
