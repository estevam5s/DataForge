# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
._*

# Secrets
.env
.env.*
!.env.example

# Backups
*.bak
*.orig

# Dumps de páginas (não fazem parte do projeto)
pagecloner_*/

# Site (Next.js)
node_modules/
site/.next/
site/out/
site/next-env.d.ts
.vercel
site/tsconfig.tsbuildinfo

# Segredos — nunca commitar
vercel_token.txt
*_token.txt
.vercel/

# Pacotes: o fonte entra, o build não
packages/*/dist/
forge_modules/

# Exceção: o tarball servido pelo site é publicado de propósito —
# é dele que 'curl … | sh' baixa a linguagem.
!site/public/dist/
!site/public/dist/**

# Projetos: dependências baixadas e dados de execução
projetos/*/forge_modules/
projetos/*/tarefas.json
projetos/*/dist/
.supabase.local
