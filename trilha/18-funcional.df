// ═══════════════════════════════════════════════════════════
//  18. Programacao funcional
// ═══════════════════════════════════════════════════════════
//
//   map(f, xs)      → xs >> morph x: f(x)
//   filter(f, xs)   → xs >> sift x: f(x)
//   reduce(f, xs)   → xs >> distill a, v: f(a, v) inicial
//   functools       → Arcane.Functional
//
// A diferenca de forma e o ponto: em Python a funcao vem antes da
// colecao, e se le de dentro para fora. O pipeline se le na ordem em
// que os dados andam.

adopt Arcane.Functional as F

nums := [1, 2, 3, 4, 5, 6]

// ── 18.1 O pipeline ──
//
// Tres operadores, e eles encadeiam.
assert (nums >> morph n: n * 2) is [2, 4, 6, 8, 10, 12]
assert (nums >> sift n: n % 2 is 0) is [2, 4, 6]
assert (nums >> distill acc, v: acc + v 0) is 21

pares_dobrados := nums
    >> sift n: n % 2 is 0
    >> morph n: n * 10
    >> distill acc, v: acc + v 0
assert pares_dobrados is 120

// ARMADILHA: o valor inicial do 'distill' vem DEPOIS do corpo, e o
// corpo come o que vier antes dele. Isto divide o ZERO:
media_errada := nums >> distill a, v: a + v 0 / len(nums)
assert media_errada is 21.0            // a soma, nao a media

// O parenteses e o que separa a dobra da conta seguinte:
media := (nums >> distill a, v: a + v 0) / len(nums)
assert media is 3.5

// ── 18.2 A compreensao, que costuma ler melhor ──
//
// Para um 'morph' com 'sift' junto, a compreensao diz a mesma coisa
// numa linha — e e a forma que a maioria do codigo usa.
assert [n * 2 cycle n in nums given n % 2 is 0] is [4, 8, 12]

// ── 18.3 Lambda ──
//
// Duas escritas: ':' para um parametro so, '=>' para varios.
dobro := lambda x: x * 2
soma := lambda a, b => a + b
assert dobro(21) is 42
assert soma(20, 22) is 42

// ARMADILHA: um pipeline dentro de um lambda precisa de parenteses. O
// corpo do lambda liga mais forte que '>>', entao sem eles quem e
// canalizado e o LAMBDA, e nao a lista.
sem_erro := lambda => (nums >> morph n: n * 2)
assert sem_erro() is [2, 4, 6, 8, 10, 12]

// ── 18.4 Acao de ordem superior ──
//
// Uma acao e um valor: entra como argumento, sai como resultado, mora
// numa lista.
action aplicar_duas_vezes(f, x):
    yield f(f(x))

assert aplicar_duas_vezes(dobro, 3) is 12

operacoes := {"dobro": dobro, "quadrado": lambda x: x * x}
assert operacoes["quadrado"](5) is 25

// ── 18.5 Closure: a acao que lembra ──
//
// 'proximo' continua enxergando o 'n' de 'contador' depois que
// 'contador' ja voltou. E o mesmo mecanismo do decorador.
action contador():
    n := 0
    action proximo() -> Integer:
        n += 1
        yield n
    yield proximo

p := contador()
assert p() is 1
assert p() is 2

// Cada chamada de 'contador' cria um estado NOVO:
q := contador()
assert q() is 1

// ── 18.6 Arcane.Functional ──
//
// 'compose' aplica da direita para a esquerda (como a notacao
// matematica); 'pipe', da esquerda para a direita (como a leitura).
mais_um := lambda x: x + 1
// compose: de tras para a frente — 'dobro' recebe o que 'mais_um' deu.
assert F.compose(dobro, mais_um)(5) is 12
// pipe: na ordem da leitura — dobra, depois soma um.
assert F.pipe(dobro, mais_um)(5) is 11

// (Os dois comentarios acima estao numa linha PROPRIA de proposito.
// Escritos no fim da linha do 'assert', '// dobro(mais_um(5))' vira
// uma DIVISAO: o que vem depois do '//' e uma chamada. E a armadilha
// do capitulo 3, vista do outro lado — ali o codigo virava
// comentario, aqui o comentario vira codigo.)

// 'partial' prende os primeiros argumentos; 'curry' aceita um por vez.
soma10 := F.partial(soma, 10)
assert soma10(5) is 15

action soma3(a, b, c):
    yield a + b + c

assert curry(soma3)(1)(2)(3) is 6
assert curry(soma3)(1, 2)(3) is 6

// 'memoize' guarda o resultado por argumento. Repare que a acao lenta
// so roda UMA vez para o mesmo 4.
chamadas := []
action lento(n):
    chamadas.append(n)
    yield n * n

rapido := F.memoize(lento)
assert rapido(4) is 16
assert rapido(4) is 16
assert chamadas is [4]

// E o resto do que se usa todo dia:
assert F.group_by(lambda n: n % 2, nums) is {1: [1, 3, 5], 0: [2, 4, 6]}
assert F.take_while(lambda n: n smaller 4, nums) is [1, 2, 3]
assert F.scan(lambda a, b => a + b, nums, 0) is [0, 1, 3, 6, 10, 15, 21]
assert F.frequencies(["a", "b", "a"]) is {"a": 2, "b": 1}

// A chave e o VALOR agrupado, e nao o texto dele: 'g[1]' funciona.
g := F.group_by(lambda n: n % 2, nums)
assert g[1] is [1, 3, 5]
assert typeof(g.keys()[0]) is "Integer"
assert F.frequencies([1, 1, 2]) is {1: 2, 2: 1}

// E, pela mesma razao, o numero 1 e o texto "1" nao sao duplicatas:
assert len(unique([1, "1"])) is 2

// ── 18.7 Sem efeito colateral, de verdade ──
//
// O pipeline devolve uma lista NOVA — o original nao muda. Mas isso e
// do pipeline, e nao da linguagem: 'append' num cluster que veio de
// fora muda o de fora, e e assim que a maioria dos bugs de estado
// compartilhado nasce.
original := [1, 2, 3]
_ := original >> morph n: n * 2
assert original is [1, 2, 3]

action impura(xs):
    xs.append(99)                      // muda o argumento de QUEM CHAMOU
    yield xs

lista := [1, 2]
_ := impura(lista)
assert lista is [1, 2, 99]

action pura(xs):
    yield [...xs, 99]                  // espalha numa lista nova

outra := [1, 2]
assert pura(outra) is [1, 2, 99]
assert outra is [1, 2]

// Para um valor que nao pode mudar por engano, 'record' resolve na
// declaracao, e nao na disciplina de quem escreve.
record Config:
    host: String
    porta: Integer

c := Config("localhost", 8080)
c2 := c with {"porta": 9090}
assert c.porta is 8080
assert c2.porta is 9090

out "18. Programacao funcional — ok"
