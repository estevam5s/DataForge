// ═══════════════════════════════════════════════════════════
//  6. Colecoes
// ═══════════════════════════════════════════════════════════

// ── 6.1 Cluster: a lista ──
nomes := ["Ana", "Joao", "Carlos"]
nomes.append("Maria")
assert len(nomes) is 4

nomes.remove("Joao")  // remove PELO VALOR, e no lugar
assert nomes is ["Ana", "Carlos", "Maria"]

// 'sorted' devolve NOVO; 'sort' ordena no lugar.
assert sorted([3, 1, 2]) is [1, 2, 3]
ns := [3, 1, 2]
ns.sort()
assert ns is [1, 2, 3]

// ARMADILHA 1: 'remove' e 'pop' mudam de sentido conforme a colecao.
//
//   Cluster: o argumento e o VALOR       Vault: e a CHAVE
//   'remove' apaga no lugar, e e CALADO quando nao acha
//   'pop'    devolve o valor, e LEVANTA quando nao acha
//   'omit'   devolve COPIA, e nao mexe no original
xs := [1, 2, 3]
remove(xs, 99)  // nao acha, nao reclama
assert xs is [1, 2, 3]
remove(xs, 2)
assert xs is [1, 3]

v := {"a": 1, "b": 2}
remove(v, "z")  // pela CHAVE, e tambem calado
assert len(v) is 2
assert pop(v, "a") is 1  // devolve o valor
assert v is {"b": 2}

levantou := no
monitor:
    pop(v, "z")  // a chave nao esta la
handle Error as e:
    levantou := yes
assert levantou

// 'omit' nao toca no original:
intacto := {"a": 1}
assert omit(intacto, "a") is {}
assert intacto is {"a": 1}

// ARMADILHA 2: a FUNCAO e o METODO de mesmo nome divergem.
//
//   remove(xs, 99)    calado
//   xs.remove(99)     LEVANTA
//
// O metodo cai direto na lista do Python; a funcao global implementa
// o contrato desta linguagem. Prefira a forma de FUNCAO — e ela e a
// unica que existe para vault, que nao tem '.remove' nem '.pop'.
metodo_levanta := no
monitor:
    xs.remove(99)
handle Error as e:
    metodo_levanta := yes
assert metodo_levanta

// ── 6.2 Tupla: nao ha, e o substituto e melhor ──
//
// Para um par posicional, use um Cluster. Para um valor com CAMPOS
// NOMEADOS e imutavel — que e o que quase toda tupla quer ser —
// use 'record': ele tem nome, tipo e igualdade estrutural.
coordenada := [10, 20]
assert coordenada[0] is 10

record Coordenada:
    x: Integer
    y: Integer
c := Coordenada(10, 20)
assert c.x is 10
assert Coordenada(10, 20) is c  // igualdade por conteudo

// ── 6.3 Set ──
//
// NAO ha literal de set: '{1, 2, 3}' e um vault mal formado, e o
// lexer reclama. O set nasce de 'Arcane.Collections.set', e as
// operacoes tem NOME em vez de simbolo — '|' e '&' nem existem como
// operador aqui.
adopt Arcane.Collections as Col

ids := Col.set([1, 2, 3, 3])
assert len(ids) is 3
assert typeof(ids) is "Set"

a := Col.set([1, 2, 3])
b := Col.set([3, 4])
assert sorted(cluster(Col.union(a, b))) is [1, 2, 3, 4]
assert sorted(cluster(Col.intersection(a, b))) is [3]
assert sorted(cluster(Col.difference(a, b))) is [1, 2]
assert sorted(cluster(Col.symmetric_difference(a, b))) is [1, 2, 4]
assert Col.is_subset(Col.set([1, 2]), a)

// Para so tirar repetidos de um cluster, 'unique' basta e devolve
// Cluster — sem virar Set e voltar.
assert unique([1, 2, 2, 3]) is [1, 2, 3]

// ── 6.4 Vault: o dicionario ──
usuario := {"nome": "Ana", "idade": 30}
assert usuario["nome"] is "Ana"
usuario["ativo"] := yes
assert usuario["ativo"]

// Uma chave que nao existe LEVANTA. Isso e deliberado: num servidor,
// devolver 'void' calado vira erro tres camadas adiante.
faltou := no
monitor:
    _ := usuario["telefone"]
handle Error as e:
    faltou := yes
assert faltou

// Para o que pode nao vir, '??':
tel := usuario["telefone"] ?? "sem telefone"
assert tel is "sem telefone"

assert sorted(keys(usuario)) is ["ativo", "idade", "nome"]
assert "nome" in usuario

// ── 6.5 Compreensoes ──
//
// A forma e '[expressao cycle x in fonte given condicao]' — a
// expressao primeiro, como se le em voz alta.
quadrados := [x ** 2 cycle x in range(10)]
assert quadrados is [0, 1, 4, 9, 16, 25, 36, 49, 64, 81]

pares := [x cycle x in range(20) given x % 2 is 0]
assert len(pares) is 10

// Vault por compreensao:
mapa := {x: x ** 2 cycle x in range(5)}
assert mapa[3] is 9

// Nao ha compreensao de SET — as chaves sao sempre vault. O
// equivalente e a compreensao de cluster passada por 'unique':
unicos := unique([x % 3 cycle x in range(10)])
assert sorted(unicos) is [0, 1, 2]

// ── 6.6 Fatiar ──
letras := ["a", "b", "c", "d", "e"]
assert letras[1:3] is ["b", "c"]
assert letras[:2] is ["a", "b"]
assert letras[3:] is ["d", "e"]
assert letras[::-1] is ["e", "d", "c", "b", "a"]
assert letras[-1] is "e"

// ── 6.7 Spread e desestruturacao ──
juntos := [...[1, 2], ...[3, 4]]
assert juntos is [1, 2, 3, 4]

primeiro, ...resto := [1, 2, 3, 4]
assert primeiro is 1
assert resto is [2, 3, 4]

padrao := {"porta": 80, "host": "local"}
com_extra := {...padrao, "porta": 8080}
assert com_extra["porta"] is 8080  // a direita vence
assert com_extra["host"] is "local"

// ── 6.8 Pipeline: filtrar, transformar, reduzir ──
//
// ARMADILHA: o valor inicial do 'distill' vem DEPOIS do corpo.
total := [1, 2, 3, 4, 5, 6]
    >> sift n: n % 2 is 0
    >> morph n: n * 10
    >> distill acc, v: acc + v 0
assert total is 120

out "6. Colecoes — ok"
