adopt Arcane.Test as T
adopt modelo as M

action test_variavel_simples():
    T.assert_eq(M.render("Olá, {{nome}}!", {"nome": "Ana"}), "Olá, Ana!")
    T.assert_eq(M.render("{{a}}+{{b}}", {"a": 1, "b": 2}), "1+2")

action test_variavel_ausente_vira_vazio():
    T.assert_eq(M.render("[{{nao_existe}}]", {}), "[]")

action test_sem_marcacao():
    T.assert_eq(M.render("texto puro", {}), "texto puro")
    T.assert_eq(M.render("", {}), "")

action test_caminho_aninhado():
    dados := {"usuario": {"nome": "Bruno", "endereco": {"cidade": "SP"}}}
    T.assert_eq(M.render("{{usuario.nome}}", dados), "Bruno")
    T.assert_eq(M.render("{{usuario.endereco.cidade}}", dados), "SP")
    T.assert_eq(M.render("{{usuario.faltando}}", dados), "")

action test_indice_de_lista():
    T.assert_eq(M.render("{{itens.0}}", {"itens": ["a", "b"]}), "a")

action test_laco_de_valores():
    r := M.render("{{#itens}}[{{.}}]{{/itens}}", {"itens": ["a", "b", "c"]})
    T.assert_eq(r, "[a][b][c]")

action test_laco_de_vaults():
    dados := {"pessoas": [{"nome": "Ana"}, {"nome": "Bruno"}]}
    r := M.render("{{#pessoas}}{{nome}};{{/pessoas}}", dados)
    T.assert_eq(r, "Ana;Bruno;")

action test_laco_vazio_nao_rende():
    T.assert_eq(M.render("a{{#itens}}X{{/itens}}b", {"itens": []}), "ab")

action test_condicional():
    T.assert_eq(M.render("{{#tem}}sim{{/tem}}", {"tem": yes}), "sim")
    T.assert_eq(M.render("{{#tem}}sim{{/tem}}", {"tem": no}), "")
    T.assert_eq(M.render("{{#tem}}sim{{/tem}}", {}), "")

action test_condicional_negada():
    T.assert_eq(M.render("{{^vazio}}nada aqui{{/vazio}}", {"vazio": []}), "nada aqui")
    T.assert_eq(M.render("{{^vazio}}nada aqui{{/vazio}}", {"vazio": [1]}), "")

action test_filtros():
    T.assert_eq(M.render("{{n | maiusculo}}", {"n": "ana"}), "ANA")
    T.assert_eq(M.render("{{n | capitalizar}}", {"n": "ana"}), "Ana")
    T.assert_eq(M.render("{{n | aparar | maiusculo}}", {"n": "  ana  "}), "ANA")
    T.assert_eq(M.render("{{l | tamanho}}", {"l": [1, 2, 3]}), "3")

action test_filtro_proprio():
    M.registrar_filtro("dobro", lambda v => v * 2)
    T.assert_eq(M.render("{{n | dobro}}", {"n": 21}), "42")

action test_bloco_sem_fechamento_avisa():
    T.assert_throws(lambda => M.render("{{#lista}}sem fim", {"lista": [1]}))
    T.assert_throws(lambda => M.render("{{sem fechar", {}))

action test_verdadeiro():
    T.assert_false(M.verdadeiro(void))
    T.assert_false(M.verdadeiro(no))
    T.assert_false(M.verdadeiro(""))
    T.assert_false(M.verdadeiro([]))
    T.assert_false(M.verdadeiro(0))
    T.assert_true(M.verdadeiro("x"))
    T.assert_true(M.verdadeiro([1]))
    T.assert_true(M.verdadeiro(1))

action test_documento_completo():
    dados := {
        "titulo": "Relatório",
        "itens": [{"nome": "café", "preco": "5,00"},
                  {"nome": "pão", "preco": "2,50"}]
    }
    saida := M.render("# {{titulo}}\n{{#itens}}- {{nome}}: {{preco}}\n{{/itens}}", dados)
    T.assert_true(saida.contains("# Relatório"))
    T.assert_true(saida.contains("- café: 5,00"))
    T.assert_eq(len(saida.split("\n")), 4)
