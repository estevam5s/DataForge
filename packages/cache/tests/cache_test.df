adopt Arcane.Test as T
adopt cache as K

action test_memoizar_evita_recalculo():
    // conta as execuções de verdade: a segunda chamada não pode
    // acrescentar nada à lista
    chamadas := []

    action lento(n):
        chamadas.append(n)
        yield n * n

    rapido := K.memoizar(lento)
    T.assert_eq(rapido(9), 81)
    T.assert_eq(len(chamadas), 1)
    T.assert_eq(rapido(9), 81)
    T.assert_eq(len(chamadas), 1)  // não recalculou
    T.assert_eq(rapido(4), 16)
    T.assert_eq(len(chamadas), 2)

action test_estatisticas():
    m := K.memo_com_estatisticas(lambda n => n * 2)
    m.chamar(5)
    m.chamar(5)
    m.chamar(6)
    e := m.estatisticas
    T.assert_eq(e["acertos"], 1)
    T.assert_eq(e["erros"], 2)
    T.assert_eq(e["guardados"], 2)

action test_memo_com_limite():
    m := K.memo_com_estatisticas(lambda n => n, 2)
    m.chamar(1)
    m.chamar(2)
    m.chamar(3)
    T.assert_eq(m.estatisticas["guardados"], 2)

action test_limpar():
    m := K.memo_com_estatisticas(lambda n => n)
    m.chamar(1)
    m.limpar()
    T.assert_eq(m.estatisticas["guardados"], 0)

action test_ttl_guarda_e_le():
    c := K.ttl(60)
    c.guardar("chave", "valor")
    T.assert_eq(c.ler("chave"), "valor")
    T.assert_eq(c.ler("ausente", "padrao"), "padrao")
    T.assert_true(c.tem("chave"))
    T.assert_false(c.tem("ausente"))
    T.assert_eq(c.tamanho, 1)

action test_ttl_expira():
    c := K.ttl(60)
    c.guardar("agora", 1)
    c.guardar("ja_venceu", 2, -1)  // validade negativa: nasce vencido
    T.assert_eq(c.ler("agora"), 1)
    T.assert_eq(c.ler("ja_venceu"), void)

action test_ttl_esquecer_e_limpar():
    c := K.ttl(60)
    c.guardar("a", 1)
    c.esquecer("a")
    T.assert_false(c.tem("a"))
    c.guardar("viva", 1)
    c.guardar("morta", 2, -1)
    T.assert_eq(c.limpar_expirados(), 1)
    T.assert_eq(c.tamanho, 1)

action test_lru_descarta_o_menos_usado():
    c := K.lru(2)
    c.guardar("a", 1)
    c.guardar("b", 2)
    c.ler("a")  // 'a' vira o mais recente
    c.guardar("c", 3)  // estoura o limite: 'b' sai
    T.assert_true(c.tem("a"))
    T.assert_false(c.tem("b"))
    T.assert_true(c.tem("c"))
    T.assert_eq(c.tamanho, 2)

action test_lru_ordem():
    c := K.lru(3)
    c.guardar("a", 1)
    c.guardar("b", 2)
    c.ler("a")
    T.assert_eq(c.chaves, ["b", "a"])
