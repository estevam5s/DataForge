// Modulo auxiliar do exercicio 099 — utilitarios de geometria

steady PI := 3.14159265

action area_circulo(raio):
    yield PI * raio ** 2

action area_retangulo(base, altura):
    yield base * altura

action perimetro_circulo(raio):
    yield 2 * PI * raio

relay PI, area_circulo, area_retangulo, perimetro_circulo
